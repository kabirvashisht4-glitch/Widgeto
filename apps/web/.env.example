# GitHub's GraphQL API rejects anonymous requests even for PUBLIC contribution
# calendars, which is the only reason this exists. Use a classic token with NO
# scopes selected — Widgeto never needs write access or private repositories.
#
#   gh auth token            # if you use the GitHub CLI
#   https://github.com/settings/tokens/new   # otherwise: no scopes, just create
GITHUB_TOKEN=

# Optional. Stack Exchange allows 300 requests a day per IP without a key and
# 10,000 with one; the Stack Overflow connector works either way, it just has
# less headroom. Register an app at https://stackapps.com/apps/oauth/register
# and use the "key" it gives you — it is an app identifier, not a credential.
# STACKEXCHANGE_KEY=

# Canonical URL, used to build absolute links in social cards. On Vercel this
# is inferred from VERCEL_URL, so it is only needed for other hosts or a custom
# domain.
# NEXT_PUBLIC_SITE_URL=https://widgeto.example.com
